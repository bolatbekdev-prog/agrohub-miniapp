{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020","DOM","DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react",
    "strict": true, "allowSyntheticDefaultImports": true, "esModuleInterop": true,
    "skipLibCheck": true, "noEmit": true, "isolatedModules": true, "resolveJsonModule": true
  },
  "include": ["src"]
}
